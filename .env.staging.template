# Fonely Staging Environment Template
# Copy to .env.staging and fill in real values before deployment.
# NEVER commit real secrets.

POSTGRES_PASSWORD=changeme-generate-a-real-password
DATABASE_URL=postgresql+asyncpg://fonely:changeme-generate-a-real-password@postgres:5432/fonely
INTERNAL_API_SECRET=changeme-generate-a-real-secret

# Logging
FONELY_LOG_FORMAT=json
FONELY_LOG_LEVEL=INFO

# Connection pool (defaults are suitable for 1–5 clinics)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# Server
# HOST=0.0.0.0
# PORT=8000
