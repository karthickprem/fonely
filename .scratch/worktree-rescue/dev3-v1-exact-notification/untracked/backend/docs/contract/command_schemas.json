{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owner Command Family Preimage Schemas",
  "oneOf": [
    { "$ref": "#/$defs/doctor_leave" },
    { "$ref": "#/$defs/close_clinic" },
    { "$ref": "#/$defs/close_early" }
  ],
  "$defs": {
    "iana_timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "pattern": "^[A-Z][a-zA-Z0-9_]+/[a-zA-Z0-9_/]+$"
    },
    "iso_date": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])$"
    },
    "hhmm_time": {
      "type": "string",
      "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
    },
    "doctor_leave": {
      "type": "object",
      "properties": {
        "family_schema": { "const": "owner-command-family-v1" },
        "business_id": { "type": "integer", "minimum": 1 },
        "owner_user_id": { "type": "integer", "minimum": 1 },
        "command_type": { "const": "doctor_leave" },
        "target_date": { "$ref": "#/$defs/iso_date" },
        "target_timezone": { "$ref": "#/$defs/iana_timezone" },
        "resource_id": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "required": ["family_schema", "business_id", "owner_user_id", "command_type", "target_date", "target_timezone", "resource_id", "reason"],
      "additionalProperties": false
    },
    "close_clinic": {
      "type": "object",
      "properties": {
        "family_schema": { "const": "owner-command-family-v1" },
        "business_id": { "type": "integer", "minimum": 1 },
        "owner_user_id": { "type": "integer", "minimum": 1 },
        "command_type": { "const": "close_clinic" },
        "target_date": { "$ref": "#/$defs/iso_date" },
        "target_timezone": { "$ref": "#/$defs/iana_timezone" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "required": ["family_schema", "business_id", "owner_user_id", "command_type", "target_date", "target_timezone", "reason"],
      "additionalProperties": false
    },
    "close_early": {
      "type": "object",
      "properties": {
        "family_schema": { "const": "owner-command-family-v1" },
        "business_id": { "type": "integer", "minimum": 1 },
        "owner_user_id": { "type": "integer", "minimum": 1 },
        "command_type": { "const": "close_early" },
        "target_date": { "$ref": "#/$defs/iso_date" },
        "target_timezone": { "$ref": "#/$defs/iana_timezone" },
        "close_time": { "$ref": "#/$defs/hhmm_time" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "required": ["family_schema", "business_id", "owner_user_id", "command_type", "target_date", "target_timezone", "close_time", "reason"],
      "additionalProperties": false
    }
  }
}
