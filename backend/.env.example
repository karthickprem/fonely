# Fonely Backend Configuration
# Copy to .env and fill in real values. Never commit .env.

# Sarvam AI
SARVAM_API_KEY=sk_your_key_here

# Exotel Telephony
EXOTEL_API_KEY=your_api_key
EXOTEL_API_TOKEN=your_api_token
EXOTEL_SID=your_account_sid
EXOTEL_PHONE_NUMBER=your_exophone

# Database (PostgreSQL, async)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/fonely

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
