# Fonely Staging Environment Template
# Copy to .env.staging and fill in real values before deployment.
# NEVER commit real secrets.

POSTGRES_PASSWORD=changeme-generate-a-real-password
# Construct DATABASE_URL from your actual credentials:
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
DATABASE_URL=
INTERNAL_API_SECRET=changeme-generate-a-real-secret

# Logging (pydantic_settings maps these directly — no FONELY_ prefix)
LOG_FORMAT=json
LOG_LEVEL=INFO

# Connection pool (defaults are suitable for 1–5 clinics)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# Server
# HOST=0.0.0.0
# PORT=8000
