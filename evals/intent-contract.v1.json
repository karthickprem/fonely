{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fonely.dev/evals/intent-contract.v1.json",
  "title": "Fonely canonical intent contract v1",
  "description": "Canonical exact-scoring intent labels. Aliases document pre-final synthetic labels and are not valid case labels.",
  "contract_version": 1,
  "intents": {
    "inventory_query": {
      "description": "Read inventory, price, or product availability.",
      "scoring": "exact"
    },
    "order_create": {
      "description": "Create a pending order proposal.",
      "scoring": "exact"
    },
    "order_revise": {
      "description": "Revise a pending order proposal.",
      "scoring": "exact"
    },
    "order_confirm": {
      "description": "Confirm a pending order.",
      "scoring": "exact"
    },
    "order_cancel": {
      "description": "Cancel an order or pending order.",
      "scoring": "exact"
    },
    "availability_query": {
      "description": "Read appointment availability or schedule.",
      "scoring": "exact"
    },
    "appointment_create": {
      "description": "Create a pending appointment proposal.",
      "scoring": "exact"
    },
    "appointment_revise": {
      "description": "Revise a pending appointment.",
      "scoring": "exact"
    },
    "appointment_confirm": {
      "description": "Confirm a pending appointment.",
      "scoring": "exact"
    },
    "appointment_cancel": {
      "description": "Cancel an appointment.",
      "scoring": "exact"
    },
    "appointment_reschedule": {
      "description": "Reschedule an appointment.",
      "scoring": "exact"
    },
    "business_information_query": {
      "description": "Read business hours, address, service, or price information.",
      "scoring": "exact"
    },
    "stock_update_propose": {
      "description": "Propose an owner stock update.",
      "scoring": "exact"
    },
    "stock_update_confirm": {
      "description": "Confirm an owner stock update.",
      "scoring": "exact"
    },
    "price_update_propose": {
      "description": "Propose an owner price update.",
      "scoring": "exact"
    },
    "price_update_confirm": {
      "description": "Confirm an owner price update.",
      "scoring": "exact"
    },
    "schedule_update_propose": {
      "description": "Propose an owner schedule update.",
      "scoring": "exact"
    },
    "schedule_update_confirm": {
      "description": "Confirm an owner schedule update.",
      "scoring": "exact"
    },
    "escalation_request": {
      "description": "Escalate to owner or clinician.",
      "scoring": "exact"
    },
    "authorization_denied": {
      "description": "Reject unauthorized or cross-tenant access.",
      "scoring": "exact"
    },
    "validation_rejected": {
      "description": "Reject invalid input, state, schema, or transition.",
      "scoring": "exact"
    },
    "clarification_request": {
      "description": "Ask the caller to clarify ambiguous information.",
      "scoring": "exact"
    },
    "runtime_recovery": {
      "description": "Handle voice/runtime silence, disconnect, timeout, or recovery.",
      "scoring": "exact"
    },
    "provider_recovery": {
      "description": "Handle provider fallback, confidence, or outage.",
      "scoring": "exact"
    },
    "internal_system_event": {
      "description": "Represent a deterministic internal lifecycle or worker event.",
      "scoring": "exact"
    },
    "response_presented": {
      "description": "Present information, confirmation summary, status, or acknowledgement.",
      "scoring": "exact"
    }
  },
