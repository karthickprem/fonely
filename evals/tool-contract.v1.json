        }
      ]
    },
    "unit": {
      "type": "string",
      "enum": [
        "kg",
        "gram",
        "piece",
        "dozen",
        "litre",
        "ml",
        "packet",
        "bottle"
      ]
    },
    "nullableUnit": {
