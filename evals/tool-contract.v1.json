          },
          "business_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "list_all": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "allowed_outcomes": [
        "authorization_denied",
        "information_presented",
        "not_found",
        "success",
        "unauthorized",
        "validation_error",
        "validation_rejected"
      ],
      "allowed_write_policies": [
        "none"
      ]
    },
