        "authorization_denied",
        "clarification_needed",
        "insufficient_stock",
        "not_found",
        "success",
        "unauthorized",
        "validation_error",
        "validation_rejected"
      ],
      "allowed_write_policies": [
        "none",
        "pending_only"
      ]
    },
    "revise_pending_order": {
