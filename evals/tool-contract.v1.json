  "internal_operations": {
    "begin_commit": {
      "description": "Internal engine transition from awaiting_confirmation to committing.",
      "llm_callable": false
    },
    "complete_commit": {
      "description": "Internal engine records a successful deterministic commit.",
      "llm_callable": false
    },
    "fail_commit": {
      "description": "Internal engine records a retryable or terminal commit failure.",
      "llm_callable": false
    },
    "internal_get": {
      "description": "Internal tenant-scoped action lookup.",
      "llm_callable": false
    },
    "internal_get_active": {
      "description": "Internal tenant/session active-action lookup.",
      "llm_callable": false
    }
  },
  "outcomes": {
    "success": "Expected operation succeeds.",
    "unauthorized": "Verified actor lacks permission.",
    "insufficient_stock": "Requested quantity is unavailable.",
    "slot_conflict": "Requested resource interval conflicts.",
    "expired": "Action or hold expired.",
    "stale_version": "Expected version is stale.",
    "not_found": "Entity is absent or hidden by tenant scoping.",
    "validation_error": "Input is invalid.",
    "no_tool": "No public tool may be called.",
    "escalate": "Escalation to owner or clinician is required.",
    "provider_error": "STT, LLM, or TTS provider failed.",
    "clarification_needed": "Caller input is ambiguous and requires clarification.",
    "information_presented": "The agent presents requested information, status, or acknowledgement without a public tool call on this turn.",
    "authorization_denied": "The request is denied by authorization or tenant-isolation policy.",
    "validation_rejected": "The request is rejected by deterministic validation or state policy.",
    "runtime_recovered": "The voice/runtime layer recovers or follows an approved failure path.",
    "provider_recovered": "Provider fallback or recovery completes according to routing policy."
  },
  "write_policies": {
    "none": "No database mutation.",
    "pending_only": "Only a pending proposal, revision, cancellation, or temporary hold may change.",
    "commit": "A deterministic engine may commit a confirmed order, appointment, or owner update."
  },
  "$defs": {
    "decimalString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
    },
    "positiveIntegerId": {
      "type": "integer",
      "minimum": 1
    },
    "nullablePositiveIntegerId": {
      "oneOf": [
