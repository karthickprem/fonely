{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fonely.dev/evals/tool-contract.v1.json",
  "title": "Fonely lifecycle-safe public tool contract v1",
  "description": "Canonical LLM-callable tools. Tenant identity and verified caller context are injected by the application and are never tool arguments.",
