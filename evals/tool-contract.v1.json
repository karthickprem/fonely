      "description": "Read current inventory for one, several, or all active products.",
      "arguments": {
        "type": "object",
        "required": [],
        "properties": {
          "product_id": {
            "$ref": "#/$defs/nullablePositiveIntegerId"
          },
          "product_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "product_ids": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/positiveIntegerId"
                },
                "minItems": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "product_names": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string",
              "minLength": 1
